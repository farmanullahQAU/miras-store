{
  "name": "miras-commerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:node": "node worker/dev-server.js",
    "cf:deploy": "vite build && wrangler deploy --dry-run --outdir /tmp/miras-bundle && cp /tmp/miras-bundle/index.js ./dist/_worker.js && wrangler pages deploy ./dist --project-name miras-store --branch main",
    "worker:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute miras-db --local --file=./worker/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute miras-db --remote --file=./worker/schema.sql",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "rolldown": "1.2.3",
    "tailwindcss": "4.3.3",
    "vite": "8.2.0",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "rolldown": "1.2.3"
  }
}
